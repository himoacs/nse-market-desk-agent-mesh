# Your LLM settings. All five NSE desk agents use this model (models/nse_sonnet.yaml).
#
# 1. Copy this file to .env       (cp .env.example .env)
# 2. Replace the placeholder values below with your own
# 3. Never commit .env: it is gitignored because it holds your API key
#
# Use a strong tool-calling model. The desk was built and tested with Claude
# Sonnet 5.5; small or weak models tend to stumble on multi-agent hand-offs.

# Provider. "custom" = any OpenAI-compatible endpoint, such as a LiteLLM gateway
# (this is the tested setup). Other values SAM accepts: openai, anthropic,
# azure_openai, bedrock, google_ai_studio, vertex_ai, ollama.
LLM_PROVIDER=custom

# Model name as your endpoint knows it. With "custom", start it with the API
# format your endpoint speaks:
#   anthropic/<model>   e.g. anthropic/claude-sonnet-5-5
#   openai/<model>      for OpenAI-style APIs
# With a built-in provider (openai, anthropic, ...), use the plain model name.
LLM_MODEL_NAME=anthropic/claude-sonnet-5-5

# Base URL of your endpoint, WITHOUT a trailing /v1.
# Required for "custom". For openai, anthropic and the other built-in providers,
# leave it empty (or delete the line) and SAM uses the provider's own endpoint.
LLM_API_BASE=https://your-llm-gateway.example.com

# Your API key
LLM_API_KEY=replace-me
