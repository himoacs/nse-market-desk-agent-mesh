# LLM used by every NSE desk agent and by the SAM instance's built-in models
# (models/*.yaml). Copy this file to .env and fill it in; sam config auto-loads
# .env from the repo root. .env is gitignored: never commit real keys.
#
# Tested setup: an OpenAI-compatible gateway such as LiteLLM, with provider
# "custom" and a Claude Sonnet model. With "custom", prefix the model with the
# API format your endpoint speaks: anthropic/<model> or openai/<model>.
# Use a strong tool-calling model (Claude Sonnet class or equivalent).
LLM_PROVIDER=custom
LLM_MODEL_NAME=anthropic/claude-sonnet-5-5
# Base URL of your LLM endpoint, WITHOUT a trailing /v1
LLM_API_BASE=https://your-llm-gateway.example.com
LLM_API_KEY=replace-me

# The desk runs in its own SAM Desktop instance (scripts/sam-desktop.sh nse).
# scripts/bootstrap.py sets SAM_HOME for you; export it for other sam commands:
#   export SAM_HOME=~/sam-homes/nse-desk
